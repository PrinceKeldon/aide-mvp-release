# AIDE local configuration example.
# Copy this file to .env, then complete setup from http://localhost:3000/setup.

# LLM routing
DEFAULT_LLM=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LOCAL_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:3b

# Optional cloud model providers
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional Telegram mobile interface
TELEGRAM_BOT_TOKEN=
TELEGRAM_STREAM_REPLIES=false

# Optional web search
TAVILY_API_KEY=
SEARXNG_URL=http://localhost:8080

# Optional email and calendar integrations
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_SAFETY_TIER=approve
PRIVATEEMAIL_ADDRESS=
PRIVATEEMAIL_PASSWORD=
GOOGLE_CALENDAR_CREDENTIALS_PATH=./data/google/calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=./data/google/calendar_token.json
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_LABEL=
GOOGLE_CALENDAR_TIMEZONE=UTC
CALENDAR_ICS_PATH=
CALENDAR_ICS_LABEL=
CALENDAR_ICS_TIMEZONE=UTC
CALENDAR_ACCOUNT_LOCAL_ICS_PATH=
CALENDAR_ACCOUNT_LOCAL_LABEL=
CALENDAR_ACCOUNT_LOCAL_TIMEZONE=UTC

# Local storage
MEMORY_DB_PATH=./data/aide_memory.db
CHROMA_DB_PATH=./data/chroma
DAILY_BRIEF_DIR=./data/daily_briefs
OBSIDIAN_VAULT_PATH=~/Obsidian/AIDEMemory

# Runtime
WEB_HOST=0.0.0.0
WEB_PORT=3000
LOG_LEVEL=INFO
LOG_FILE=./data/aide.log
MESH_PORT=7432
